# Add TF_VAR_ prefix for Terraform
TF_VAR_aws_region=eu-central-1
TF_VAR_kube_context=local-datalab
TF_VAR_data_lab_namespace=data-lab
TF_VAR_airflow_namespace=airflow
TF_VAR_aws_access_key=test
TF_VAR_aws_secret_key=test
TF_VAR_aws_endpoint=http://localhost:4566
TF_VAR_raw_satellite_bucket=raw-satellite-data
TF_VAR_processed_aoi_bucket=processed-aoi-data
TF_VAR_airflow_dags_bucket=airflow-dags
TF_VAR_airflow_logs_bucket=airflow-logs
TF_VAR_analytics_db_name=analytics
TF_VAR_analytics_db_user=analytics
TF_VAR_analytics_db_password=analytics
# Keep regular env vars for other services
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
AWS_ENDPOINT_URL=http://localhost:4566
KUBE_CONTEXT=local-datalab
DATA_LAB_NAMESPACE=data-lab
AIRFLOW_NAMESPACE=airflow
RAW_SATELLITE_BUCKET=raw-satellite-data
PROCESSED_AOI_BUCKET=processed-aoi-data
AIRFLOW_DAGS_BUCKET=airflow-dags
AIRFLOW_LOGS_BUCKET=airflow-logs
ANALYTICS_DB_HOST=127.0.0.1
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics
ANALYTICS_DB_SCHEMA=raw
